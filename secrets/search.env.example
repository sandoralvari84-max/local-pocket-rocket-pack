# Copy to search.env to configure web search. Read per search; no restart needed.
# auto    = keyless, tries Mojeek, then DuckDuckGo lite, then Bing (recommended; resists rate limits)
# brave   = Brave Search API (free key at https://api.search.brave.com/app/keys) - most reliable
# searxng = your own SearXNG instance (json output enabled)
SEARCH_BACKEND=auto
#BRAVE_API_KEY=
#SEARXNG_URL=http://host.docker.internal:8888
